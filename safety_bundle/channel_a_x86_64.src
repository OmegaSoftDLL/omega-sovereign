  qec_surface_code_distance_ok(3, 2) == 0

fn lsa9_hv(c) = let o = ord(c) in if o >= 48 and o <= 57 then o - 48 else if o >= 65 and o <= 70 then o - 55 else 0 - 1
fn lsa9_word(s, i, k, acc) = if k == 0 then acc else let d = lsa9_hv(at(s, i)) in if d < 0 then 0 - 1 else lsa9_word(s, i + 1, k - 1, acc * 16 + d)
fn lsa9_bit(c, k) = if k == 0 then c else lsa9_bit(bit_xor(c / 2, if c % 2 == 1 then 3988292384 else 0), k - 1)
fn lsa9_crc(s, i, e, c) = if i >= e then bit_xor(c, 4294967295) else lsa9_crc(s, i + 1, e, lsa9_bit(bit_xor(c, ord(at(s, i))), 8))
fn lsa9_h1(n) = at("0123456789ABCDEF", n)
fn lsa9_hex8(w) = lsa9_h1(w / 268435456 % 16) + lsa9_h1(w / 16777216 % 16) + lsa9_h1(w / 1048576 % 16) + lsa9_h1(w / 65536 % 16) + lsa9_h1(w / 4096 % 16) + lsa9_h1(w / 256 % 16) + lsa9_h1(w / 16 % 16) + lsa9_h1(w % 16)
fn lsa9_s32(u) = if u >= 2147483648 then u - 4294967296 else u
fn lsa9_u32(v) = if v < 0 then v + 4294967296 else v
fn lsa9_w(s, i) = lsa9_word(s, 8 * i, 8, 0)
fn lsa9_fmt(s, i) = if i >= 15 then 1 else if lsa9_w(s, i) < 0 then 0 else lsa9_fmt(s, i + 1)
fn lsa9_wellformed(s) = if count(s) == 121 and at(s, 120) == "\n" then lsa9_fmt(s, 0) else 0
fn lsa9_echo(s, ok, i, n) = if i >= n then "" else (if ok == 1 then lsa9_hex8(lsa9_w(s, i)) else "00000000") + lsa9_echo(s, ok, i + 1, n)
fn lsa9_frame(body) = body + lsa9_hex8(lsa9_crc(body, 0, count(body), 4294967295)) + "\n"
fn lsa9_resp(s, ok, status, cause, result) = lsa9_frame("4C53525300000001" + lsa9_echo(s, ok, 2, 3) + "8EA70FEB22B96351A0000001" + lsa9_echo(s, ok, 5, 14) + lsa9_hex8(status) + lsa9_hex8(cause) + lsa9_hex8(result) + "00000000")
fn lsa9_bad(s) = if lsa9_wellformed(s) != 1 then 6 else if lsa9_crc(s, 0, 112, 4294967295) != lsa9_w(s, 14) then 5 else if lsa9_w(s, 0) != 1280528977 then 1 else if lsa9_w(s, 1) != 1 then 2 else if lsa9_hex8(lsa9_w(s, 3)) + lsa9_hex8(lsa9_w(s, 4)) != "8EA70FEB22B96351" then 3 else if lsa9_w(s, 5) != 6 then 4 else 0
fn lsa9_call(s) = dfe_calc_vnf(lsa9_s32(lsa9_w(s, 6)), lsa9_s32(lsa9_w(s, 7)), lsa9_s32(lsa9_w(s, 8)), lsa9_s32(lsa9_w(s, 9)), lsa9_s32(lsa9_w(s, 10)), lsa9_s32(lsa9_w(s, 11)))
fn lsa9_ok(s) = let r = lsa9_call(s) in if r < 0 - 2147483648 or r > 2147483647 then lsa9_resp(s, 1, 1, 6, 0) else lsa9_resp(s, 1, 0, 0, lsa9_u32(r))
fn lsa9_main(s) = let c = lsa9_bad(s) in let w = fs_write_sync("/dev/stdout", if c != 0 then lsa9_resp(s, lsa9_wellformed(s), 2, c, 0) else lsa9_ok(s)) in os_exit(0)
print lsa9_main(readall())
