## --- PILLAR [03] & [04]: Binary Assurance (2oo2D RV32IM, MC/DC, lstack) & [C0011] CT Crypto / X.509v3 ---

@secret
@no_alloc
fn ct_select_word_v5(sel_bit: int, word_a: int, word_b: int) -> int
= ct_select(0 - bit_and(sel_bit, 1), bit_and(word_a, 4294967295), bit_and(word_b, 4294967295))

@secret
@no_alloc
fn ct_tag_verify_v5(tag_a: int, tag_b: int, mask_nonce: int) -> int
= ct_eq(bit_xor(bit_and(tag_a, 4294967295) +% bit_and(mask_nonce, 65535), bit_and(tag_b, 4294967295) +% bit_and(mask_nonce, 65535)), 0)

