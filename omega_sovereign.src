  requires raw_bytes >= 0 and compressed_bytes >= 0 and compressed_bytes <= raw_bytes
  ensures result >= 0 and result + compressed_bytes == raw_bytes
= raw_bytes - compressed_bytes

fn perceus_sum_deltas(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => perceus_sum_deltas(t, acc + h)

