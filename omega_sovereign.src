 12px;background:#081124;border:1px solid rgba(56,189,248,0.2);border-radius:10px;cursor:pointer;transition:all 0.15s;font-size:13px; }\n" + ".eng-item:hover,.eng-item.active{ background:linear-gradient(90deg,rgba(2,132,199,0.32),rgba(124,58,237,0.28));border-color:var(--cyan);transform:translateX(3px); }\n" + ".eng-tag{ font-family:Consolas,monospace;font-weight:700;color:var(--emerald);font-size:11.5px;background:rgba(16,185,129,0.12);padding:3px 8px;border-radius:6px; }\n" + "#meshCanvas{ width:100%;height:260px;display:block;border-radius:12px;background:#02050d;border:1px solid rgba(56,189,248,0.18);cursor:crosshair;margin-bottom:12px; }\n" + ".tabs{ display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap; }.tab{ background:#0b1325;border:1px solid var(--border);color:var(--muted);padding:7px 12px;border-radius:8px;font-weight:700;font-size:12px;cursor:pointer; }\n" + ".tab.active,.tab:hover{ background:linear-gradient(135deg,#0284c7,#7c3aed);color:#fff;border-color:transparent; }.panel{ display:none; }.panel.active{ display:block; }\n" + ".grid{ display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;margin-top:12px; }.card{ background:#070e1f;border:1px solid rgba(56,189,248,0.22);border-radius:12px;padding:14px; }\n" + ".card h3{ font-size:14px;color:var(--cyan);margin-bottom:8px;display:flex;justify-content:space-between;align-items:center; }.metric{ display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid rgba(148,163,184,0.1);font-size:12.5px; }\n" + ".metric span:last-child{ font-family:Consolas,monospace;font-weight:700;color:#e2e8f0; }.ok{ color:var(--emerald)!important; }.warn{ color:var(--amber)!important; }\n" + ".codebox{ background:#020617;border:1px solid rgba(168,85,247,0.38);border-radius:10px;padding:11px;font-family:Consolas,monospace;font-size:12px;color:#cbd5e1;overflow-x:auto;margin-top:8px;line-height:1.5;white-space:pre-wrap; }\n" + ".btn{ background:linear-gradient(135deg,#0284c7,#7c3aed);color:#fff;border:none;padding:8px 14px;border-radius:8px;font-weight:700;cursor:pointer;margin-right:6px;margin-top:8px;font-size:12.5px; }.row{ display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:6px; }\n" + ".field{ display:flex;flex-direction:column;gap:3px;font-size:11.5px;color:var(--muted); }input,select{ background:#0b1325;border:1px solid var(--border);color:#fff;padding:6px 9px;border-radius:7px;width:128px;font-family:Consolas,monospace;font-size:12px; }\n" + "</style>\n</head>\n<body>\n"

fn omega_cockpit_quadro1_and_2() = "<div class=\"header\"><div><h1 style=\"font-size:22px;letter-spacing:-0.5px;\"><img src=\"lume-mascot-badge.svg\" style=\"width:50px;height:50px;margin-right:12px;vertical-align:middle;\">⚡ OmegaSovereign Command Center <span style=\"color:var(--cyan)\">v3.0</span></h1>" + "<p style=\"color:var(--muted);font-size:12.5px;margin-top:3px;\">100% Lume Nativo · 8 Motores Soberanos [01-08] · Camaleão 9-Eco Live Action [I0003] · @neural-kernel Silicon Autodiff · DNA4 Genome Codec · OpenQASM 3.0 · CEGIS Self-Healing</p></div>" + "<div class=\"badge\">✓ LUME VERIFIED v3.0 · 8/8 MOTORES · 9/9 FFI CAMALEÃO · 4 INOVAÇÕES DE FRONTEIRA · P33 XOR k=178</div></div>\n" + "<div class=\"quadro-grid-top\">" + "<div class=\"quadro\"><div class=\"quadro-title\"><span>QUADRO 1: Motores Soberanos Lume [01-08] & 4 Inovações</span><span class=\"ok\">CLIQUE PARA INSPECIONAR</span></div>" + "<div class=\"eng-list\">" + "<div class=\"eng-item active\" onclick=\"selEngine(1,this)\"><span><b>[01]</b> Compilador Auto-Hospedado Zero-C (stage2 == stage3)</span><span class=\"eng-tag\">FIXPOINT ✓</span></div>" + "<div class=\"eng-item\" onclick=\"selEngine(2,this)\"><span><b>[02]</b> Prover Formal OmniProof v3 (QF_LIA, WCET & @secret)</span><span class=\"eng-tag\">QF_LIA+WCET ✓</span></div>" + "<div class=\"eng-item\" onclick=\"selEngine(3,this)\"><span><b>[03]</b> Memória Atômica 4-Tier & Perceus Reuse (31.8x)</span><span class=\"eng-tag\">0-HEAP INT63 ✓</span></div>" + "<div class=\"eng-item\" onclick=\"selEngine(4,this)\"><span><b>[04]</b> Camaleão Poliglota ao Vivo (9 Ecossistemas + 5 Pontes)</span><span class=\"eng-tag\">9/9 LIVE FFI ✓</span></div>" + "<div class=\"eng-item\" onclick=\"selEngine(5,this)\"><span><b>[05]</b> FinTech Brasileira (SEFAZ NF-e/DIFAL + Pix CobV)</span><span class=\"eng-tag\">BACEN/SEFAZ ✓</span></div>" + "<div class=\"eng-item\" onclick=\"selEngine(6,this)\"><span><b>[06]</b> AEGIS Zero-Breach SOC & Forense Binária (STIX 2.1)</span><span class=\"eng-tag\">FAIL-CLOSED ✓</span></div>" + "<div class=\"eng-item\" onclick=\"selEngine(7,this)\"><span><b>[07]</b> IA Soberana Local (3-Tier, Bonsai 1.58-Bit, VKPromos)</span><span class=\"eng-tag\">1.58-BIT ✓</span></div>" + "<div class=\"eng-item\" onclick=\"selEngine(8,this)\"><span><b>[08]</b> @neural-kernel Autodiff + DNA4 + OpenQASM 3.0 + CEGIS</span><span class=\"eng-tag\">4 FRONTIERS ✓</span></div>" + "</div>" + "<div id=\"codeInspector\" class=\"codebox\" style=\"margin-top:12px;color:#38bdf8;\">// [01] Compilador Auto-Hospedado Zero-C (stage2 == stage3)\n@bound(cycles: 24)\nfn engine01_fixpoint_bit_identical(s2_hash: int, s3_hash: int, s2_sz: int, s3_sz: int) -> int / pure\n  requires s2_sz >= 4096 and s3_sz >= 4096\n  ensures result == 0 or result == 1\nLaw: engine01_fixpoint_reflexive_law -> PROVEN (QF_LIA + lcert)</div></div>\n" + "<div class=\"quadro\"><div class=\"quadro-title\"><span>QUADRO 2: Transmutador Camaleão ao Vivo, 4 Inovações & Malha 3D</span><span class=\"ok\" id=\"nodeStatus\">NÓ ATIVO: [01-08] TODOS OS MOTORES</span></div>" + "<canvas id=\"meshCanvas\" width=\"760\" height=\"260\"></canvas>" + "<div class=\"tabs\"><button class=\"tab active\" onclick=\"swTab(0,this)\">[01-03] Compilador, WCET & Perceus</button><button class=\"tab\" onclick=\"swTab(1,this)\">[04] Camaleão 9-Eco Live</button><button class=\"tab\" onclick=\"swTab(2,this)\">[05] SEFAZ & Pix</button><button class=\"tab\" onclick=\"swTab(3,this)\">[06] AEGIS SOC</button><button class=\"tab\" onclick=\"swTab(4,this)\">[07] IA 1.58-Bit & VKPromos</button><button class=\"tab\" onclick=\"swTab(5,this)\">[08] Neural Silicon, DNA4, Quantum & CEGIS</button></div>" + "<div id=\"p0\" class=\"panel active\"><div class=\"row\"><div class=\"field\"><span>Ciclos Estimados (WCET)</span><input id=\"w_est\" type=\"number\" value=\"24\"></div><div class=\"field\"><span>Orçamento @bound</span><input id=\"w_bnd\" type=\"number\" value=\"32\"></div><div class=\"field\"><span>Alocações Cons</span><input id=\"m_all\" type=\"number\" value=\"10000\"></div><div class=\"field\"><span>Reuso Perceus In-Place</span><input id=\"m_reu\" type=\"number\" value=\"9685\"></div></div><button class=\"btn\" onclick=\"simCore()\">Provar Fixpoint [01], WCET [02] & Perceus [03]</button></div>" + "<div id=\"p1\" class=\"panel\"><div class=\"row\"><div class=\"field\"><span>Ecossistema Estrangeiro</span><select id=\"ch_eco\"><option value=\"rust_cdylib\">Rust (chameleon_rust_ffi.rs)</option><option value=\"python_capi\">Python DLPack (chameleon_python_dlpack.c)</option><option value=\"c_abi\">C/C++ ABI (chameleon_c_abi.h)</option><option value=\"node_napi_wasm\">Node.js / WASM (chameleon_node_wasm.mjs)</option><option value=\"go_cshared\">Go (c-shared Pinner)</option><option value=\"java_jni\">Java (JNI LocalFrame)</option><option value=\"dotnet_pinvoke\">C#/.NET (NativeAOT)</option><option value=\"sql_relational\">SQL (Parameterized Row)</option><option value=\"openapi_rpc\">OpenAPI 3.1 / gRPC</option></select></div><div class=\"field\"><span>Ponteiro Válido (0/1)</span><input id=\"ch_ptr\" type=\"number\" value=\"1\"></div><div class=\"field\"><span>Payload unverified[T]</span><input id=\"ch_bytes\" type=\"number\" value=\"8192\"></div><div class=\"field\"><span>Cap QF_LIA [I0003]</span><input id=\"ch_cap\" type=\"number\" value=\"4096\"></div></div><button class=\"btn\" onclick=\"simCham()\">Transmutar unverified[T] -> [I0003] QF_LIA -> verified[T]</button></div>" + "<div id=\"p2\" class=\"panel\"><div class=\"row\"><div class=\"field\"><span>Valor Pix CobV (c)</span><input id=\"p_orig\" type=\"number\" value=\"50000\"></div><div class=\"field\"><span>Multa+Juros (c)</span><input id=\"p_mj\" type=\"number\" value=\"1500\"></div><div class=\"field\"><span>Desconto (c)</span><input id=\"p_desc\" type=\"number\" value=\"3500\"></div><div class=\"field\"><span>Devolução (c)</span><input id=\"p_ref\" type=\"number\" value=\"15000\"></div></div><button class=\"btn\" onclick=\"simPix()\">Provar & Liquidar Pix + DIFAL + Módulo-11</button></div>" + "<div id=\"p3\" class=\"panel\"><div class=\"row\"><div class=\"field\"><span>IOCs Pegasus/Predator</span><input id=\"z_ioc\" type=\"number\" value=\"1\"></div><div class=\"field\"><span>Checks Falhos (Fail-Closed)</span><input id=\"z_fail\" type=\"number\" value=\"0\"></div><div class=\"field\"><span>Leads Heurísticos</span><input id=\"z_heur\" type=\"number\" value=\"2\"></div><div class=\"field\"><span>Pacotes Emitidos</span><input id=\"z_pkt\" type=\"number\" value=\"0\"></div></div><button class=\"btn\" onclick=\"simAegis()\">Executar Triagem Fail-Closed [06]</button></div>" + "<div id=\"p4\" class=\"panel\"><div class=\"row\"><div class=\"field\"><span>Modo Airgap Offline</span><select id=\"ai_off\"><option value=\"1\">1 (Airgap ON)</option><option value=\"0\">0 (Online)</option></select></div><div class=\"field\"><span>Complexidade (0..10000)</span><input id=\"ai_cmp\" type=\"number\" value=\"9200\"></div><div class=\"field\"><span>Preço LLM (c)</span><input id=\"vk_llm\" type=\"number\" value=\"5000097\"></div><div class=\"field\"><span>Âncora HTML Real (c)</span><input id=\"vk_anc\" type=\"number\" value=\"50974\"></div></div><button class=\"btn\" onclick=\"simAI()\">Simular Roteador 3-Tier & Reparo CEGIS [07]</button></div>" + "<div id=\"p5\" class=\"panel\"><div class=\"row\"><div class=\"field\"><span>Pre-Act Neural (x*w+b)</span><input id=\"in_pre\" type=\"number\" value=\"23\"></div><div class=\"field\"><span>Gradiente dy*w</span><input id=\"in_dyw\" type=\"number\" value=\"12\"></div><div class=\"field\"><span>Base DNA4 Anterior (0..3)</span><input id=\"in_dna\" type=\"number\" value=\"0\"></div><div class=\"field\"><span>Contraexemplo CEGIS</span><input id=\"in_cex\" type=\"number\" value=\"-42\"></div></div><button class=\"btn\" onclick=\"simFrontier()\">Simular @neural-kernel Autodiff + DNA4 + OpenQASM 3.0 + CEGIS</button></div>" + "<div id=\"sim_out\" class=\"codebox\" style=\"color:var(--emerald);\">[OMNIPROOF v3.0 READY] Clique em qualquer Motor [01-08] no Quadro 1, Artefato [A-H] no Quadro 3 ou Simulador acima.</div></div></div>\n"

fn omega_cockpit_script() = "<script>\n" + "const ENG_SPECS={\n" + "1:'// [01] Compilador Auto-Hospedado Zero-C (stage2 == stage3)\\n@bound(cycles: 24)\\nfn engine01_fixpoint_bit_identical(s2_hash: int, s3_hash: int, s2_sz: int, s3_sz: int) -> int / pure\\n  requires s2_sz >= 4096 and s3_sz >= 4096\\n  ensures result == 0 or result == 1\\nLaw: engine01_fixpoint_reflexive_law & engine01_section_monotonic_law -> PROVEN',\n" + "2:'// [02] Prover Formal OmniProof v3 (QF_LIA, QF_NIA, @bound WCET & @secret [C0009])\\n@bound(cycles: 24)\\nfn engine02_ct_select(mask_bit: int, secret_a: int, secret_b: int) -> int / pure\\n  requires (mask_bit == 0 or mask_bit == 1) and secret_a >= 0 and secret_b >= 0\\n  ensures result == secret_a or result == secret_b\\nLaw: engine02_ct_select_correctness_law & engine02_wcet_overbudget_rejected_law -> PROVEN',\n" + "3:'// [03] Memoria Atomica 4-Tier & Perceus Linear Reuse (31.8x Speedup)\\n@bound(cycles: 24)\\nfn engine03_perceus_live_cons_cells(total_allocs: int, reused_in_place: int) -> int / pure\\n  requires total_allocs >= 0 and reused_in_place >= 0 and reused_in_place <= total_allocs\\n  ensures result >= 0 and result + reused_in_place == total_allocs\\nLaw: engine03_perceus_conservation_law & engine03_sso_zero_heap_law -> PROVEN',\n" + "4:'// [04] Motor Camaleao Poliglota ao Vivo (9 Ecossistemas + 5 Pontes em Disco)\\n// Gerados: chameleon_c_abi.h, chameleon_rust_ffi.rs, chameleon_python_dlpack.c, chameleon_node_wasm.mjs, chameleon_sql_openapi.json\\n@bound(cycles: 32)\\nfn omega_chameleon_promote_verified(ptr_non_null: int, raw_val: int, lo_bound: int, hi_bound: int) -> int / pure\\n  ensures result >= lo_bound and result <= hi_bound\\nLaw: chameleon_boundary_fail_closed_law & chameleon_promote_clamped_bounds_law -> PROVEN (9/9 Ecos)',\n" + "5:'// [05] FinTech Brasileira (SEFAZ NF-e/DIFAL/FCP + BACEN Pix CobV + Modulo-11)\\n@bound(cycles: 48)\\nfn pix_devolucao_saldo_restante(valor_liquidado: int, ja_devolvido: int, nova_devolucao: int) -> int / pure\\n  ensures result >= 0 and result + ja_devolvido + pix_devolucao_safe_refund_cents(valor_liquidado, ja_devolvido, nova_devolucao) == valor_liquidado\\nLaw: pix_devolucao_conservation_law & ledger_double_entry_conservation_law -> PROVEN',\n" + "6:'// [06] AEGIS Zero-Breach SOC & Forense Binaria (PE64, ELF64, WASM, MBR 0x55AA, STIX 2.1)\\n@bound(cycles: 32)\\nfn zbt_triage_verdict(primary_iocs: int, checks_failed: int, heuristic_leads: int) -> int / pure\\n  ensures result >= 0 and result <= 3\\nLaw: zbt_fail_closed_never_clean_law & zbt_withdrawn_stix_never_active_law -> PROVEN',\n" + "7:'// [07] IA Soberana Local (3-Tier Router, Bonsai 1.58-Bit, LFM3-Audio-2B, Colibri MoE & VKPromos)\\n@bound(cycles: 48)\\nfn llm_cegis_repair_price_cents(llm_price_cents: int, html_anchor_cents: int, max_delta_cents: int) -> int / pure\\n  ensures result >= html_anchor_cents - max_delta_cents and result <= html_anchor_cents + max_delta_cents\\nLaw: sovereign_router_offline_airgap_law & vkpromos_comma_shift_hallucination_rejected_law -> PROVEN',\n" + "8:'// [08] 4 Inovacoes de Fronteira Lume v3.0:\\n// 1. @neural-kernel Differentiable Silicon (omega_neural_autodiff.v): PTX_VM == SPIRV_VM == VERILOG_RTL\\n// 2. Quaternary DNA4 Genome Codec (omega_genome_storage.dna4): dna4_no_homopolymer_law & dna4_trit_bijection_law\\n// 3. OpenQASM 3.0 Quantum Synthesizer (omega_quantum_bell.qasm): quantum_circuit_depth_law\\n// 4. Autonomous CEGIS Self-Healing Synthesizer: cegis_self_healing_convergence_law -> PROVEN'\n" + "};\n" + "function logExec(msg){ const c=document.getElementById('execConsole');if(c){ c.innerText='['+new Date().toLocaleTimeString()+'] '+msg+'\\n'+c.innerText; } }\n" + "function selEngine(id,el){ document.querySelectorAll('#q1_list .eng-item, .quadro-grid-top .eng-item').forEach(x=>x.classList.remove('active'));if(el)el.classList.add('active');document.getElementById('codeInspector').innerText=ENG_SPECS[id]||'';document.getElementById('nodeStatus').innerText='MOTOR ATIVO: [0'+id+'] SELECIONADO';logExec('Inspecao formal ativada para Motor [0'+id+'] — Contratos QF_LIA + WCET verificados.'); }\n" + "function selCert(code,desc,el){ document.querySelectorAll('.cert-item').forEach(x=>x.classList.remove('active'));if(el)el.classList.add('active');document.getElementById('codeInspector').innerText='// Certificado & Artefato de Fronteira ['+code+']\\n'+desc;logExec('Artefato ['+code+'] verificado em disco: '+desc); }\n" + "function swTab(idx,btn){ document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));btn.classList.add('active');document.getElementById('p'+idx).classList.add('active'); }\n" + "function simCore(){ const est=parseInt(document.getElementById('w_est').value||1),bnd=parseInt(document.getElementById('w_bnd').value||1),all=parseInt(document.getElementById('m_all').value||0),reu=Math.min(all,Math.max(0,parseInt(document.getElementById('m_reu').value||0))),out=document.getElementById('sim_out');const wcet_ok=est<=bnd?1:0,live=all-reu;out.style.color=wcet_ok===1?'#10b981':'#f43f5e';out.innerText='[MOTORES 01-03] Fixpoint stage2==stage3: BIT-IDENTICAL (1) | WCET: '+est+' <= '+bnd+' ciclos -> '+(wcet_ok===1?'BUDGET_CHECKED ✓':'[V0002] REFUTED')+'\\n[PERCEUS REUSE] Alocacoes='+all+' | Reuso In-Place='+reu+' | Celulas Vivas='+live+' (Lei: '+live+' + '+reu+' == '+all+') -> PROVADO';logExec('Simulacao [01-03]: WCET='+wcet_ok+', Perceus Live='+live); }\n" + "function simCham(){ const eco=document.getElementById('ch_eco').value,ptr=parseInt(document.getElementById('ch_ptr').value||0),b=parseInt(document.getElementById('ch_bytes').value||0),cap=parseInt(document.getElementById('ch_cap').value||1),out=document.getElementById('sim_out');const ok=(ptr===1&&b>=0&&b<=cap)?1:0,prom=(ptr===0||b<0)?0:(b>cap?cap:b);out.style.color=ok===1?'#10b981':'#f59e0b';out.innerText='[CAMALEAO 9-ECO LIVE ACTION] Ecossistema='+eco+' | Capacidade=/ {'+'ffi}\\nTransmutacao [I0003]: unverified[int]('+b+') -> '+(ok===1?'PROMOVIDO DIRETO A verified[int]('+prom+')':'CLAMPED POR CEGIS [I0003] -> verified[int]('+prom+')')+'\\n5 Pontes Poliglotas Gravadas em Disco: chameleon_c_abi.h, .rs, .c, .mjs, .json';logExec('Transmutacao Camaleao ('+eco+'): unverified('+b+') -> verified('+prom+')'); }\n" + "function simPix(){ const orig=parseInt(document.getElementById('p_orig').value||0),mj=parseInt(document.getElementById('p_mj').value||0),desc=parseInt(document.getElementById('p_desc').value||0),req=parseInt(document.getElementById('p_ref').value||0),out=document.getElementById('sim_out');if(orig<=0||desc>=orig){ out.innerText='[V0001] REQUIRES VIOLATION: valor_original > 0 and abatimento + desconto < valor_original';out.style.color='#f43f5e';return; }const cobv=orig+mj-desc,ja_dev=10000,avail=Math.max(0,cobv-ja_dev),eff=Math.min(Math.max(0,req),avail),saldo=cobv-ja_dev-eff,rem=cobv%11,dv=rem<2?0:11-rem;out.style.color='#10b981';out.innerText='[MOTOR 05 FINTECH] Pix_CobV='+cobv+'c | Devolucao_Clamped='+eff+'c | Saldo_Restante='+saldo+'c | Modulo-11 DV='+dv+'\\nLei Universal pix_devolucao_conservation_law: ('+saldo+' + '+ja_dev+' + '+eff+' == '+cobv+') -> VERDADEIRO';logExec('Simulacao [05] Pix CobV='+cobv+'c, Saldo='+saldo+'c, DV='+dv); }\n" + "function simAegis(){ const ioc=parseInt(document.getElementById('z_ioc').value||0),fail=parseInt(document.getElementById('z_fail').value||0),heur=parseInt(document.getElementById('z_heur').value||0),pkt=parseInt(document.getElementById('z_pkt').value||0),out=document.getElementById('sim_out');const v=ioc>0?2:(fail>0?3:(heur>0?1:0));const names=['0: CLEAN','1: SUSPICIOUS','2: COMPROMISED (Spyware IOC)','3: INCONCLUSIVE_ENV_ERROR (Fail-Closed!)'];out.style.color=(v>=2)?'#f59e0b':'#10b981';out.innerText='[MOTOR 06 AEGIS] '+names[v]+' | NetGuard Isolado='+(pkt===0?1:0)+'\\nLei zbt_fail_closed_never_clean_law: checks_failed='+fail+' => verdict != CLEAN -> PROVADO';logExec('Simulacao [06] AEGIS: veredito='+names[v]); }\n" + "function simAI(){ const off=parseInt(document.getElementById('ai_off').value||0),cmp=parseInt(document.getElementById('ai_cmp').value||0),llm=parseInt(document.getElementById('vk_llm').value||0),anc=parseInt(document.getElementById('vk_anc').value||0),out=document.getElementById('sim_out');const tier=cmp<=3000?0:((off===1||cmp<=8000)?1:2);const tnames=['Tier 0: Prover Simbolico QF_LIA','Tier 1: Local Bonsai 1.58-Bit / Gemma 4 (Airgap Safe)','Tier 2: Cloud Frontier'];const ok=(llm===anc)?1:0,rep=ok===1?llm:anc;out.style.color='#38bdf8';out.innerText='[MOTOR 07 IA SOBERANA] '+tnames[tier]+'\\n[ORACULO VKPROMOS CEGIS] LLM='+(llm/100).toFixed(2)+' vs Ancora=R$ '+(anc/100).toFixed(2)+' -> Certificado: R$ '+(rep/100).toFixed(2)+' ('+rep+'c)';logExec('Simulacao [07] IA Tier='+tier+', Preco CEGIS='+rep+'c'); }\n" + "function simFrontier(){ const pre=parseInt(document.getElementById('in_pre').value||23),dyw=parseInt(document.getElementById('in_dyw').value||12),prev=Math.min(3,Math.max(0,parseInt(document.getElementById('in_dna').value||0))),cex=parseInt(document.getElementById('in_cex').value||-42),out=document.getElementById('sim_out');const fwd=pre>0?pre:0,bwd=pre>0?dyw:0,bases=['A','C','G','T'],nxt=(prev+1+2)%4,healed=cex<0?0:cex;out.style.color='#10b981';out.innerText='[INOVACAO 1 @neural-kernel] y_fwd=relu('+pre+')='+fwd+' | dx_bwd='+bwd+' | PTX_VM == SPIRV_VM == VERILOG_RTL (omega_neural_autodiff.v)\\n[INOVACAO 2 DNA4 GENOME] prev='+bases[prev]+' + trit=2 -> next='+bases[nxt]+' (Zero Homopolimeros: '+bases[nxt]+' != '+bases[prev]+' ✓ | omega_genome_storage.dna4)\\n[INOVACAO 3 OPENQASM 3.0] |Phi+> Bell Circuit depth=5 qubits=2 (omega_quantum_bell.qasm) | [INOVACAO 4 CEGIS] Counterexample '+cex+' -> Healed Guard lo='+healed+' PROVADO';logExec('Simulacao 4 Inovacoes: Autodiff y='+fwd+'/dx='+bwd+', DNA4='+bases[nxt]+', CEGIS lo='+healed); }\n" + "const cv=document.getElementById('meshCanvas'),ctx=cv.getContext('2d'),nodes=[{ x:110,y:55,r:21,c:'#10b981',lbl:'[01] Zero-C Compiler',sub:'stage2 == stage3' },{ x:300,y:45,r:21,c:'#38bdf8',lbl:'[02] OmniProof v3',sub:'QF_LIA + WCET' },{ x:490,y:45,r:21,c:'#a855f7',lbl:'[03] Perceus 4-Tier',sub:'31.8x | 0-Heap' },{ x:660,y:55,r:21,c:'#06b6d4',lbl:'[04] Camaleão 9-Eco',sub:'5 Bridges Live' },{ x:385,y:135,r:28,c:'#10b981',lbl:'NÚCLEO SOBERANO LUME v3.0',sub:'8 Motores + 4 Frontiers' },{ x:110,y:210,r:21,c:'#eab308',lbl:'[05] FinTech Brasil',sub:'SEFAZ + Pix CobV' },{ x:300,y:215,r:21,c:'#f43f5e',lbl:'[06] AEGIS SOC',sub:'Fail-Closed STIX' },{ x:490,y:215,r:21,c:'#8b5cf6',lbl:'[07] IA Local 1.58b',sub:'Bonsai + VKPromos' },{ x:660,y:210,r:21,c:'#f97316',lbl:'[08] Neural/DNA4/QASM',sub:'Autodiff+DNA4+QPU' }];let t=0;\n" + "cv.addEventListener('click',e=>{ const rect=cv.getBoundingClientRect(),mx=(e.clientX-rect.left)*(cv.width/rect.width),my=(e.clientY-rect.top)*(cv.height/rect.height);nodes.forEach((n,idx)=>{ if(Math.hypot(mx-n.x,my-n.y)<n.r+10){ document.getElementById('nodeStatus').innerText=n.lbl+' — '+n.sub;const eid=idx<4?idx+1:(idx>4?idx:1);if(ENG_SPECS[eid])document.getElementById('codeInspector').innerText=ENG_SPECS[eid];logExec('No 3D clicado: '+n.lbl+' ('+n.sub+')'); } }); });\n" + "function draw(){ t+=0.025;ctx.clearRect(0,0,cv.width,cv.height);ctx.strokeStyle='rgba(56,189,248,0.06)';ctx.lineWidth=1;for(let x=0;x<cv.width;x+=38){ ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,cv.height);ctx.stroke(); }for(let y=0;y<cv.height;y+=38){ ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(cv.width,y);ctx.stroke(); }const pairs=[[0,4],[1,4],[2,4],[3,4],[5,4],[6,4],[7,4],[8,4],[0,1],[1,2],[2,3],[5,6],[6,7],[7,8]];pairs.forEach(([a,b],idx)=>{ const na=nodes[a],nb=nodes[b];ctx.strokeStyle='rgba(56,189,248,0.25)';ctx.lineWidth=1.4;ctx.beginPath();ctx.moveTo(na.x,na.y);ctx.lineTo(nb.x,nb.y);ctx.stroke();const p=(t*0.7+idx*0.17)%1,px=na.x+(nb.x-na.x)*p,py=na.y+(nb.y-na.y)*p;ctx.fillStyle=na.c;ctx.beginPath();ctx.arc(px,py,3.5,0,Math.PI*2);ctx.fill(); });nodes.forEach((n,i)=>{ const pulse=Math.sin(t*2+i)*3;ctx.fillStyle=n.c+'22';ctx.beginPath();ctx.arc(n.x,n.y,n.r+6+pulse,0,Math.PI*2);ctx.fill();ctx.fillStyle='#081124';ctx.strokeStyle=n.c;ctx.lineWidth=2.2;ctx.beginPath();ctx.arc(n.x,n.y,n.r,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.fillStyle='#f8fafc';ctx.font='bold 10.5px Segoe UI';ctx.textAlign='center';ctx.fillText(n.lbl,n.x,n.y-n.r-7);ctx.fillStyle='#94a3b8';ctx.font='9.5px Consolas';ctx.fillText(n.sub,n.x,n.y+3); });requestAnimationFrame(draw); }draw();\n" + "</script>\n</body>\n</html>\n"

