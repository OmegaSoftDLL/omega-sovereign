@bound(cycles: 32)
fn engine01_pe64_section_align(raw_offset: int, pad_bytes: int) -> int / pure
  requires raw_offset >= 4096 and pad_bytes >= 0 and pad_bytes < 4096
  ensures result >= raw_offset and result >= 4096 and result == raw_offset + pad_bytes
= raw_offset + pad_bytes

