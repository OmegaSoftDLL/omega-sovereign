fn perceus_sum_deltas(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => perceus_sum_deltas(t, acc + h)

fn omega_gui_pipeline() = let ws = Cons(ui_widget(101, 4, 2, rgb_pack(16, 185, 129), 48000, "PixCobV"), Cons(ui_widget(202, 4, 2, rgb_pack(56, 189, 248), 50974, "VKPromos"), Cons(ui_widget(303, 4, 2, rgb_pack(168, 85, 247), 390, "AEGIS"), Nil))) in let laid = ui_vbox_layout(ws, 1, 1, 1) in let fb = ui_render_widgets(canvas_new(8, 10, rgb_pack(11, 15, 25)), laid) in let click1 = ui_dispatch_click(100000, laid, 2, 2) in let click2 = ui_dispatch_click(click1.state, laid, 2, 5) in let ppm = canvas_to_ppm(fb) in let svg = ui_to_svg(320, 240, laid) in let v_old = Cons(wasm_dom_vnode("div", 1, "Status: Booting", 0), Cons(wasm_dom_vnode("span", 2, "Balance: R$ 1.000,00", 1), Nil)) in let v_new = Cons(wasm_dom_vnode("div", 1, "Status: Lume v1.1.0 Verified (12 Sovereign Pillars)", 1), Cons(wasm_dom_vnode("span", 2, "Balance: R$ 1.989,74", 1), Cons(wasm_dom_vnode("badge", 3, "P33-SEAL-ACTIVE", 1), Nil))) in let dom_patches = wasm_dom_encode_patches(wasm_dom_diff_nodes(v_old, v_new)) in let w_ppm = fs_write_sync("omega_framebuffer.ppm", ppm) in let w_svg = fs_write_sync("omega_widgets.svg", svg) in {fb_checksum: canvas_checksum(fb), next_state: click2.state, dom_patches: dom_patches}

