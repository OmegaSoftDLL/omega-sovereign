fn wgui_emit_pe64_hex(protect_mode: int) -> str =
  let seal = if protect_mode == 1 then wgui_str_slot_hex("LUME_SEAL:P33_MAX:178:PE64_GUI", 32, 0) else "" in
  wgui_pe64_headers_hex() + wgui_pe64_text_hex(protect_mode) + wgui_pe64_idata_hex() + wgui_pe64_data_hex(protect_mode) + wgui_pe64_rsrc_hex() + seal

fn synth_main() =
  let hex_gui = wgui_emit_pe64_hex(0) in
  let hex_p33 = wgui_emit_pe64_hex(1) in
  let w1 = fs_write_sync("omega_gui.hex", hex_gui) in
  let w2 = fs_write_sync("omega_p33.hex", hex_p33) in
  let e1 = fs_write_hex_file("OmegaSovereign_GUI.exe", hex_gui) in
  let e2 = fs_write_hex_file("OmegaSovereign_P33.exe", hex_p33) in
  "{\"ok\":true,\"gui_hex_len\":" + str(count(hex_gui)) + ",\"p33_hex_len\":" + str(count(hex_p33)) + ",\"gui_exe_written\":" + str(e1) + ",\"p33_exe_written\":" + str(e2) + "}"

print synth_main()
