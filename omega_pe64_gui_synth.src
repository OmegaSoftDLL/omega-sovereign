    "  ensures result >= 0 and result >= v_prod - v_desc\r\n" +
    "= (v_prod - v_desc) + v_st + v_frete + v_ipi\r\n\r\n" +
    "law pix_devolucao_conservation_law(valor_liquidado: int, ja_devolvido: int, nova_devolucao: int) =\r\n" +
    "  if valor_liquidado >= 0 and ja_devolvido >= 0 and ja_devolvido <= valor_liquidado and nova_devolucao >= 0 then\r\n" +
    "    let eff = pix_devolucao_safe_refund_cents(valor_liquidado, ja_devolvido, nova_devolucao) in\r\n" +
    "    let saldo = pix_devolucao_saldo_restante(valor_liquidado, ja_devolvido, nova_devolucao) in\r\n" +
    "    saldo + ja_devolvido + eff == valor_liquidado\r\n" +
