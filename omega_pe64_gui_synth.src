fn wgui_hex_nib(n: int) -> str = let v = (n % 16 + 16) % 16 in if v < 10 then str(v) else if v == 10 then "a" else if v == 11 then "b" else if v == 12 then "c" else if v == 13 then "d" else if v == 14 then "e" else "f"

fn wgui_u8_hex(b: int) -> str = let v = (b % 256 + 256) % 256 in wgui_hex_nib(v / 16) + wgui_hex_nib(v % 16)

fn wgui_u16_hex(v: int) -> str = let u = (v % 65536 + 65536) % 65536 in wgui_u8_hex(u % 256) + wgui_u8_hex(u / 256)

fn wgui_u32_hex(v: int) -> str = let u = if v < 0 then 4294967296 + v else v in wgui_u16_hex(u % 65536) + wgui_u16_hex(u / 65536 % 65536)

fn wgui_u64_hex(lo: int, hi: int) -> str = wgui_u32_hex(lo) + wgui_u32_hex(hi)

fn wgui_rep_b16(b2: str) -> str = b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2 + b2
fn wgui_rep_b64(b2: str) -> str = let s = wgui_rep_b16(b2) in s + s + s + s
fn wgui_rep_b256(b2: str) -> str = let s = wgui_rep_b64(b2) in s + s + s + s

fn wgui_fill_hex(b2: str, n: int) -> str = if n <= 0 then "" else if n >= 256 then wgui_rep_b256(b2) + wgui_fill_hex(b2, n - 256) else if n >= 64 then wgui_rep_b64(b2) + wgui_fill_hex(b2, n - 64) else if n >= 16 then wgui_rep_b16(b2) + wgui_fill_hex(b2, n - 16) else b2 + wgui_fill_hex(b2, n - 1)

fn wgui_zeros_hex(n: int) -> str = wgui_fill_hex("00", n)

fn wgui_pad_hex(hex_s: str, target_bytes: int) -> str = let cur_b = count(hex_s) / 2 in if cur_b >= target_bytes then slice(hex_s, 0, target_bytes * 2) else hex_s + wgui_zeros_hex(target_bytes - cur_b)

fn wgui_pad_hex_fill(hex_s: str, target_bytes: int, fill_b2: str) -> str = let cur_b = count(hex_s) / 2 in if cur_b >= target_bytes then slice(hex_s, 0, target_bytes * 2) else hex_s + wgui_fill_hex(fill_b2, target_bytes - cur_b)

fn wgui_str_xor_loop(s: str, i: int, n: int, xk: int, acc: str) -> str = if i >= n then acc else wgui_str_xor_loop(s, i + 1, n, xk, acc + wgui_u8_hex(bit_xor(ord(at(s, i)), xk)))

fn wgui_str_slot_hex(s: str, target_bytes: int, xk: int) -> str = let max_n = if count(s) >= target_bytes then target_bytes - 1 else count(s) in let body = wgui_str_xor_loop(s, 0, max_n, xk, "") in wgui_pad_hex_fill(body, target_bytes, wgui_u8_hex(xk))

