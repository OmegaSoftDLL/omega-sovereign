  let lower_data = wgui_pad_hex(wgui_pe64_data_slots_0_to_39(k) + wgui_pe64_data_slots_40_to_79(k) + s_title + s_status + s_log + s_code + s_sdd + s_audit_title + s_audit_body + s_filter + s_defext + s_cmd_run + s_cmd_prv + s_cmd_tst + s_svg_path + s_open_verb + s_hex_table, 16384) in
